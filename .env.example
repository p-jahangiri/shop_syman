# Copy values from your private environment. scripts/init-local-env.py generates local secrets.
SQL_SA_PASSWORD=
AUTH_SIGNING_KEY=
BOOTSTRAP_ADMIN_PASSWORD=
# Storefront: preview or api. Set in the storefront process (not a VITE variable).
SHOP_DATA_MODE=preview
# SHOP_API_URL=http://127.0.0.1:5080
# Only for the explicitly labelled production build of the preview:
# SHOP_ENABLE_PREVIEW=true
# Optional PWA kill switch; production builds enable public-only offline browsing by default.
# SHOP_PWA_ENABLED=false
# Trusted canonical origin; request Host is never used for SEO URLs.
# SHOP_PUBLIC_URL=https://your-domain.example
# Indexing also requires a non-preview API and published site.seo.allowIndexing for each locale.
SHOP_ENABLE_INDEXING=false
