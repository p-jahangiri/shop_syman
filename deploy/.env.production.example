# Copy to /opt/sayman/shared/production.env on the Linux host; chmod 600.
# Only literal KEY=value lines are supported by the deployment validator.
# Quote secrets with single quotes; use no interpolation, multiline values or export.
SHOP_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
# Choose an approved official nginx Alpine image and copy its real sha256 digest.
NGINX_IMAGE=nginx:stable-alpine@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
# SQL Server is external: provision/licence it separately; encrypt and validate TLS.
# Runtime principal: DML only. Migration principal: required schema permissions.
ConnectionStrings__Shop='Server=tcp:sql.example.com,1433;Database=Sayman;User Id=sayman_runtime;Password=REPLACE;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15'
MIGRATION_CONNECTION_STRING='Server=tcp:sql.example.com,1433;Database=Sayman;User Id=sayman_migrator;Password=REPLACE;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15'
# Generate separately for production (at least 64 UTF-8 bytes); never reuse local keys.
Auth__SigningKey='REPLACE_WITH_A_UNIQUE_RANDOM_PRODUCTION_KEY_AT_LEAST_64_UTF8_BYTES'
DataProtection__CertificatePassword='REPLACE_WITH_PFX_PASSWORD'
SHOP_ENABLE_INDEXING=false
SHOP_PWA_ENABLED=true
# Disabled means unavailable. Production supports HTTPS S3, never Filesystem.
Media__Storage=Disabled
Files__Storage=Disabled
# To enable public images/private documents set the corresponding Storage=S3,
# S3__Endpoint=https://s3.example.com, S3__Bucket, S3__AccessKey, S3__SecretKey and S3__Region.
# Use different buckets for public images and private files.
# Media__S3__Endpoint=https://s3.example.com
# Media__S3__Bucket=sayman-public
# Media__S3__AccessKey='REPLACE'
# Media__S3__SecretKey='REPLACE'
# Media__S3__Region=us-east-1
# Media__ClamAvHost=clamav.internal
# Files__S3__Endpoint=https://s3.example.com
# Files__S3__Bucket=sayman-private
# Files__S3__AccessKey='REPLACE'
# Files__S3__SecretKey='REPLACE'
# Files__S3__Region=us-east-1
# Files__ClamAvHost=clamav.internal
# Actual payment/SMS/email/Holoo providers remain unavailable without verified setup.
# Do not add development provider flags or a Bootstrap__AdminPassword here.
