# Copy to /opt/sayman/shared/deploy/deploy.env and restrict access to root.
# Supply the exact initial application image references from the tested release.
API_IMAGE=REPLACE_WITH_API_IMAGE_REFERENCE
STOREFRONT_IMAGE=REPLACE_WITH_STOREFRONT_IMAGE_REFERENCE
ADMIN_IMAGE=REPLACE_WITH_ADMIN_IMAGE_REFERENCE
SQL_IMAGE=mcr.microsoft.com/mssql/server@sha256:cf8f0ab2ebe61feec2eed2629061a07d247f791c2a8ddda74a4ac9f06a291718
NGINX_IMAGE=nginx@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311
SAYMAN_SHARED=/opt/sayman/shared
SAYMAN_TLS_DIR=/opt/sayman/shared/test-tls
# SSH tunnel mode. For the edge profile, set the actual HTTPS origins instead.
SHOP_ORIGIN=http://127.0.0.1:13000
ADMIN_ORIGIN=http://127.0.0.1:13173
SHOP_DOMAIN=shop.example.test
ADMIN_DOMAIN=admin.example.test
# HTTPS edge: SHOP_ORIGIN=https://<ip>:8443 and ADMIN_ORIGIN=https://<ip>.
SHOP_TLS_PORT=8443
# Optional plain-HTTP public storefront on the shared IP while TLS issuance is pending.
SHOP_HTTP_BROWSE=false
# SHOP_LEGACY_DOMAIN=old-shop.example.test
# Set true for HTTPS edge; leave false for loopback HTTP.
SAYMAN_SECURE_AUTH_COOKIES=false
TESTER_IP=192.0.2.10
