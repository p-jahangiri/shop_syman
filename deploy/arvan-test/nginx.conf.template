map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# Public document routes, shared by HTTP and HTTPS browsing.
map "$request_method:$uri" $shop_browse_page {
    default 0;
    ~^(GET|HEAD):/$ 1;
    ~^(GET|HEAD):/(fa|en)/?$ 1;
    ~^(GET|HEAD):/(fa|en)/(catalog|compare|budget-finder|browse-access|install|installments|moments|support)/?$ 1;
    ~^(GET|HEAD):/(fa|en)/(product|blog|pages|guides|mobile-news)(/[-a-zA-Z0-9_]+)?/?$ 1;
}
# Anonymous browsing only. POST is limited to catalog reads.
map "$request_method:$uri" $shop_browse_allowed {
    default $shop_browse_page;
    ~^(GET|HEAD):/(fa|en)/manifest\.webmanifest$ 1;
    ~^(GET|HEAD):/(?:webui/assets|products|media/catalog|media/videos|pwa|magazine)/[-a-zA-Z0-9_./]+$ 1;
    ~^(GET|HEAD):/(webui/image|favicon-32\.png|favicon-192\.png|favicon\.ico|robots\.txt)$ 1;
    ~^GET:/api/catalog/(fa|en)/filters$ 1;
    ~^POST:/api/catalog/(fa|en)/(search|lookup|facet-values)$ 1;
}
map "$request_method:$uri" $shop_browse_access_path {
    default "";
    ~^(GET|HEAD):/(?<shop_access_locale>fa|en)/(account|addresses|cart|checkout|credit|devices|notifications|orders|phone-interests|purchase-requests|support/tickets|wishlist)(?:/|$) /$shop_access_locale/browse-access;
}
map "${SHOP_HTTP_BROWSE}:$shop_browse_page" $shop_legacy_public_page {
    default 0;
    "true:1" 1;
}
map $server_port $shop_browse_authority {
    8443 ${SHOP_DOMAIN}:${SHOP_TLS_PORT};
    default ${SHOP_DOMAIN};
}
map $server_port $shop_browse_forwarded_port {
    8443 ${SHOP_TLS_PORT};
    default $server_port;
}
# Cookies are scoped to a host, not a port. Pass only the app's own
# cookies upstream, and keep ambiguous duplicates invalid.
map $http_cookie $shop_refresh_cookie {
    default "";
    "~(?:^|;\s*)__Host-sayman_refresh=[^;]*(?:;[^;]*)*;\s*__Host-sayman_refresh=" "__Host-sayman_refresh=invalid";
    "~(?:^|;\s*)__Host-sayman_refresh=(?<shop_refresh>[^;]*)" "__Host-sayman_refresh=$shop_refresh";
}
map $http_cookie $shop_cart_cookie {
    default "";
    "~(?:^|;\s*)sayman_cart=[^;]*(?:;[^;]*)*;\s*sayman_cart=" "sayman_cart=invalid; ";
    "~(?:^|;\s*)sayman_cart=(?<shop_cart>[^;]*)" "sayman_cart=$shop_cart; ";
}
map $http_cookie $admin_refresh_cookie {
    default "";
    "~(?:^|;\s*)__Host-sayman_admin_refresh=[^;]*(?:;[^;]*)*;\s*__Host-sayman_admin_refresh=" "__Host-sayman_admin_refresh=invalid";
    "~(?:^|;\s*)__Host-sayman_admin_refresh=(?<admin_refresh>[^;]*)" "__Host-sayman_admin_refresh=$admin_refresh";
}
resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
server_names_hash_bucket_size 128;
client_max_body_size 10m;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_certificate /etc/nginx/sayman-tls/fullchain.pem;
ssl_certificate_key /etc/nginx/sayman-tls/privkey.pem;

server {
    listen 80 default_server;
    server_name _;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 444; }
}
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        set $shop_public_browse ${SHOP_HTTP_BROWSE};
        if ($shop_public_browse != true) { return 308 https://${ADMIN_DOMAIN}$request_uri; }
        include /etc/nginx/conf.d/sayman-public-browse.inc;
    }
}
server {
    listen 80;
    server_name ${SHOP_LEGACY_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / {
        if ($shop_legacy_public_page = 1) { return 302 http://${SHOP_DOMAIN}$uri$is_args$args; }
        return 308 ${SHOP_ORIGIN}$request_uri;
    }
}
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl;
    server_name ${SHOP_LEGACY_DOMAIN};
    add_header X-Robots-Tag 'noindex, nofollow' always;
    return 308 ${SHOP_ORIGIN}$request_uri;
}
server {
    listen 8443 ssl default_server;
    server_name _;
    return 444;
}
server {
    listen 8443 ssl;
    server_name ${SHOP_DOMAIN};
    add_header X-Robots-Tag 'noindex, nofollow' always;
    location / {
        allow ${TESTER_IP};
        deny all;
        error_page 403 = @shop_https_guest;
        set $app http://storefront:3000;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host ${SHOP_DOMAIN}:${SHOP_TLS_PORT};
        proxy_set_header X-Forwarded-Host ${SHOP_DOMAIN}:${SHOP_TLS_PORT};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Sayman-Public-Browse "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Cookie "$shop_cart_cookie$shop_refresh_cookie";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cookie_flags ~ secure;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
    location @shop_https_guest {
        include /etc/nginx/conf.d/sayman-public-browse.inc;
    }
}
server {
    listen 443 ssl;
    server_name ${ADMIN_DOMAIN};
    add_header X-Robots-Tag 'noindex, nofollow' always;
    location / {
        allow ${TESTER_IP};
        deny all;
        error_page 403 = @shop_https_guest;
        set $app http://admin:8080;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Cookie $admin_refresh_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cookie_flags ~ secure;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
    location @shop_https_guest {
        include /etc/nginx/conf.d/sayman-public-browse.inc;
    }
}
