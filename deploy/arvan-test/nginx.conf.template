map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
server_names_hash_bucket_size 128;
client_max_body_size 10m;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_certificate /etc/nginx/sayman-tls/fullchain.pem;
ssl_certificate_key /etc/nginx/sayman-tls/privkey.pem;

server {
    listen 80 default_server;
    server_name ${SHOP_DOMAIN} ${ADMIN_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl;
    server_name ${SHOP_DOMAIN};
    add_header X-Robots-Tag 'noindex, nofollow' always;
    location / {
        allow ${TESTER_IP};
        deny all;
        set $app http://storefront:3000;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cookie_flags ~ secure;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
}
server {
    listen 443 ssl;
    server_name ${ADMIN_DOMAIN};
    add_header X-Robots-Tag 'noindex, nofollow' always;
    location / {
        allow ${TESTER_IP};
        deny all;
        set $app http://admin:8080;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cookie_flags ~ secure;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
}
