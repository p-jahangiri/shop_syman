{
  "name": "sayman-shop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sayman/storefront",
    "build": "npm run build --workspace @sayman/storefront",
    "start": "npm run start --workspace @sayman/storefront",
    "typecheck": "npm run typecheck --workspace @sayman/storefront",
    "test": "node --experimental-strip-types --test apps/storefront/lib/*.test.ts",
    "dev:admin": "npm run dev --workspace @sayman/admin",
    "build:admin": "npm run build --workspace @sayman/admin",
    "typecheck:admin": "npm run typecheck --workspace @sayman/admin",
    "dev:api": "python3 scripts/backend-local.py",
    "test:admin-contract": "node --experimental-strip-types --test apps/admin/src/*.test.ts",
    "test:admin-server": "node --test apps/admin/server.test.mjs apps/admin/server.security.test.mjs apps/admin/vercel-handler.test.mjs",
    "lint": "node scripts/run-code-quality.mjs lint",
    "lint:fix": "node scripts/run-code-quality.mjs lint:fix",
    "format": "node scripts/run-code-quality.mjs format",
    "format:check": "node scripts/run-code-quality.mjs format:check"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
